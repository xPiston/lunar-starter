# Generated by `phpstan analyse --generate-baseline`: the 31 errors below are
# ALL confined to app/Infrastructure/Lunar/** (verified: `grep -c path:
# app/Infrastructure` must equal the total number of entries) and trace back
# to a single root cause, not 31 separate bugs.
#
# Lunar resolves its Eloquent models through static methods like
# `Currency::modelClass()` (to let a project swap the underlying model via
# config): Larastan can't follow this dynamic indirection and falls back to
# the generic `Illuminate\Database\Eloquent\Model` type for most Lunar
# relations, where the real type at runtime is actually concrete
# (`Lunar\Models\ProductVariant`, `Lunar\Models\Currency`...) — confirmed by
# the test suite, which exercises every one of these real paths against a
# real Postgres database.
#
# Do not blindly regenerate this file on every `composer update`: any new
# entry must first be understood (a new, untyped Lunar touchpoint, or a real
# regression?) before being accepted here.
parameters:
	ignoreErrors:
		-
			message: '#^Access to an undefined property Lunar\\Models\\Contracts\\Currency\:\:\$code\.$#'
			identifier: property.notFound
			count: 1
			path: app/Infrastructure/Lunar/Cart/CartMapper.php

		-
			message: '#^Parameter \#1 \$callback of method Illuminate\\Database\\Eloquent\\Collection\<int,Illuminate\\Database\\Eloquent\\Model\>\:\:map\(\) expects callable\(Illuminate\\Database\\Eloquent\\Model, int\)\: App\\Domain\\Cart\\CartLine, Closure\(Lunar\\Models\\CartLine\)\: App\\Domain\\Cart\\CartLine given\.$#'
			identifier: argument.type
