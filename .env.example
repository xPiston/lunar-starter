APP_NAME=Shop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Lunar doesn't support SQLite: PostgreSQL (or MySQL) is required.
# `docker compose up -d db` provides a local instance at these coordinates.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5436
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit (docker compose up -d mailpit) catches everything locally - inbox
# at http://localhost:8025. Point MAIL_HOST/MAIL_PORT at a real
# SMTP/API provider in production (see README's "Transactional email").
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stripe test keys (https://dashboard.stripe.com/test/apikeys). The webhook
# secret is provided by `stripe listen` locally, or by the dashboard once
# the /stripe/webhook endpoint is configured in production.
STRIPE_KEY=sk_test_...
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Error tracking via the Sentry SDK, pointed at a self-hosted GlitchTip
# instance (see docker-compose.glitchtip.yml and the README) rather than
# Sentry's own SaaS - same wire protocol, no vendor lock-in. Left empty, the
# SDK just doesn't send anything; nothing else in the app depends on it.
SENTRY_LARAVEL_DSN=

# Abandoned cart reminders (see docs/features.md). One email per cart left
# behind, sent by the hourly `carts:send-abandoned-reminders` schedule - so
# nothing goes out unless the scheduler is running. The rest of the knobs
# (delay, maximum cart age, link lifetime, batch size) are in
# config/abandoned_carts.php.
ABANDONED_CART_REMINDERS_ENABLED=true

# Product search (see the README's "Product search" section): `collection`
# is Scout's own default, needs no external service, and is what
# LunarProductCatalog::search() is built against. Switch to `meilisearch` or
# `algolia` for a real catalog - only this value and `artisan scout:import`
# change, LunarProductCatalog itself doesn't.
SCOUT_DRIVER=collection

# ERP synchronisation (see the README's "Pushing orders to an ERP"). OFF by
# default: `none` binds a gateway that does nothing, so a shop without an ERP
# has nothing to configure and nothing to switch off. Set to `odoo` or
# `dolibarr` to push every paid order - customer included - through a queued
# job, so checkout never waits on an ERP. The rest (retries, backoff, timeout,
# whether orders arrive confirmed) is in config/erp.php.
#
# `docker compose -f docker-compose.erp.yml up -d` runs either one locally.
ERP_DRIVER=none

# Odoo. ODOO_DATABASE is the database NAME inside the Odoo server, the one in
# the selector at sign-in - the API will not guess it. ODOO_API_KEY is a key
# from Preferences > Account Security, not the account password: it can be
# revoked on its own and cannot sign in to the web interface. The Sales app
# must be installed, or sale.order does not exist.
ODOO_URL=http://localhost:8069
ODOO_DATABASE=
ODOO_USERNAME=
ODOO_API_KEY=

# Dolibarr. The URL WITHOUT /api/index.php. The key belongs to the user the
# orders are created as, found on their card once Web Services (REST API) is
# enabled under Home > Setup > Modules - that user needs rights on third
# parties and orders, or every write comes back 403.
DOLIBARR_URL=http://localhost:8081
DOLIBARR_API_KEY=

# Analytics. Both empty by default: nothing third-party is loaded until you
# put an id here. Use Tag Manager OR the GA4 id directly, not both - a GA4 tag
# inside the container plus this one counts every page view twice.
#
# ANALYTICS_REQUIRE_CONSENT=true denies every storage type before any tag
# loads (Google Consent Mode) and mounts the consent banner. Setting it to
# false collects everything from the first byte and shows no banner, which is
# what the CNIL fines shops for. See config/analytics.php.
GOOGLE_TAG_MANAGER_ID=
GOOGLE_ANALYTICS_ID=
ANALYTICS_REQUIRE_CONSENT=true

VITE_APP_NAME="${APP_NAME}"
